# Copy to .env and fill in. NEVER commit .env.
#
# Any Sepolia endpoint that serves historical state — the suite pins a fork block, so a
# pruned/full node will fail with "missing trie node" or similar. Archive access is enough;
# no funded keys, no broadcasting, no API key of any other kind is needed.
SEPOLIA_RPC_URL=https://sepolia.example-provider.com/<your-key>
